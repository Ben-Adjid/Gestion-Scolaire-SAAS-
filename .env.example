# Application
APP_NAME="Gestion Scolaire CRUD"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://gestscolaire.example.com
APP_KEY=

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gestion_scolaire
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@gestscolaire.com
MAIL_FROM_NAME="Gestion Scolaire"

# SMS (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# AI/ML (OpenAI)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# Payment (Stripe)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Authentication
JWT_SECRET=
JWT_EXPIRATION=86400

# Frontend
REACT_APP_API_URL=https://api.gestscolaire.example.com/api
VITE_API_URL=https://api.gestscolaire.example.com/api

# Security
SANCTUM_STATEFUL_DOMAINS=gestscolaire.example.com
SANCTUM_GUARD=web

# Monitoring
LOG_CHANNEL=stack
LOG_LEVEL=info
SENTRY_LARAVEL_DSN=

# AWS (Optional - for S3 backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Features
FEATURE_AI_ALERTS=true
FEATURE_MOBILE_APP=true
FEATURE_STRIPE_PAYMENTS=true
