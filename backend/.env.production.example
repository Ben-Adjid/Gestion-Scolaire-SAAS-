# ==========================================================================
# Modèle de configuration de PRODUCTION — plateforme scolaire
# ==========================================================================
# 1. Copier ce fichier sur le serveur sous le nom « .env » (dans backend/) :
#      cp .env.production.example .env
# 2. Remplacer TOUTES les valeurs vides et les mentions « votre-domaine.com ».
# 3. Générer la clé d'application, une seule fois, sur le serveur :
#      php artisan key:generate
#    (ne jamais copier APP_KEY depuis un autre environnement)
#
# Aucun secret ne doit figurer dans ce fichier ni dans le dépôt Git.
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME="Gestion Scolaire"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.votre-domaine.com
FRONTEND_URL=https://app.votre-domaine.com
APP_TIMEZONE=UTC

# --- Journaux (sans données personnelles) ----------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de données (utilisateur MySQL dédié, jamais « root ») -----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_scolaire
DB_USERNAME=
DB_PASSWORD=

# --- Sessions, cache, file d'attente ---------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=local
# « database » : les e-mails et reçus partent via le worker (laravel-worker.service).
QUEUE_CONNECTION=database

# --- Sécurité : domaines autorisés ----------------------------------------
# Seule l'adresse publique du site peut appeler l'API (CORS) et ouvrir une session.
CORS_ALLOWED_ORIGINS=https://app.votre-domaine.com
SANCTUM_STATEFUL_DOMAINS=app.votre-domaine.com

# --- Messagerie : Brevo SMTP ------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Gestion Scolaire"

# --- WhatsApp Cloud API (connexion par téléphone, notifications) -----------
# Laisser vide si la connexion WhatsApp n'est pas activée.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUE=fr

# --- Pointage des enseignants ----------------------------------------------
# OBLIGATOIRE à false en production : sinon la position GPS n'est pas vérifiée.
POINTAGE_MODE_TEST=false

# --- Paiements -------------------------------------------------------------
# Secret partagé avec le prestataire de paiement des abonnements (vérification des notifications).
PAIEMENT_WEBHOOK_SECRET=
# Coordonnées de la plateforme affichées sur les factures d'abonnement.
PAIEMENT_DEVISE=XOF
PAIEMENT_MOBILE_LIBELLE=
PAIEMENT_MOBILE_NUMERO=
PAIEMENT_MOBILE_TITULAIRE=
PAIEMENT_BANQUE_NOM=
PAIEMENT_BANQUE_TITULAIRE=
PAIEMENT_BANQUE_COMPTE=
PAIEMENT_BANQUE_IBAN=
PAIEMENT_BANQUE_BIC=

# Note : aucune passerelle de paiement en ligne (PayDunya, etc.) n'est intégrée à la plateforme
# à ce jour. Il n'y a donc aucune variable à renseigner pour elle.
